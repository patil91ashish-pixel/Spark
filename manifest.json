{
  "manifest_version": 3,
  "name": "Spark - New Tab",
  "version": "1.0.0",
  "description": "A beautiful and minimal new tab page with time, quotes, goals, and todos",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
