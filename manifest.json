{
  "manifest_version": 3,
  "name": "Spark - New Tab",
  "version": "1.0.1",
  "description": "A beautiful and minimal new tab page with time, quotes, goals, and todos",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://api.quotable.io/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
